@using Databasing;
@using Microsoft.EntityFrameworkCore;
@using Databasing.Entities;

@model IEnumerable<Product>

@{
    ViewData["title"] = "Products";

    IEnumerable<Product> products = Model;
}

<script>
    const redirectToCreateButton = function() {
        window.location.href = "/Product/CreateProduct";
    };
</script>

<div class="app_container text-center" id="app_container" itemid="app_container" name="app_container">@{
    <button onclick="window.location.reload()" class="refresh_list_button">Refresh List</button>
    <button onclick="redirectToCreateButton()" class="create_product_button">Create Product</button>
    <br/>

    @if(Model.Count() > 0) {
        @using(Html.BeginForm("DeletePost", "Product", FormMethod.Post)) {
            <table>
                <tr>
                    <th>Product ID</th>
                    <th>Product Name</th>
                    <th>Product Description</th>
                    <th>Product Existences</th>
                        <th>Product Weights</th>
                        <th>Product Price</th>
                    <th hidden="true">Operations</th>
                </tr>

                <!-- FIXME: iterating "Model" is confusing -->
                @foreach(Product prod in Model) {
                    <tr>
                        <td>@prod.product_id</td>
                        <td>@prod.product_name</td>
                        <td>@prod.product_description</td>
                        <td>@prod.product_existence</td>
                        <td>@prod.product_weight</td>
                        <td>@prod.product_price</td>
                            <td><button name="product_id" value="@prod.product_id" asp-controller="Product" asp-action="DeleteProduct">Delete</button></td>
                            <td><button type="button" name="product_id" value="@prod.product_id" onclick="window.location.href='/Product/ModifyProduct?product_id=@prod.product_id'">Modify</button></td>
                    </tr>
                }
            </table>
        }

    } else {
        <h2 class="sad_emoticon">:(</h2>
        <br/>
        <p>The product list is empty</p>
    }
}</div>