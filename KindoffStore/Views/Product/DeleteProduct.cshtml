@using Databasing.Entities;

@{
    ViewData["title"] = "Product Deleted!";
}

<div class="app_container" id="app_container" name="app_container">@{
    <h2>:D</h2>
    <br/>

    <h4>Product deleted!</h4>
    <table>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Product Description</th>
            <th>Product Existence</th>
            <th>Product Weight</th>
        </tr>
        <tr>
            <td>@((Product) ViewData["deleted_object"]!).product_id</td>
            <td>@((Product) ViewData["deleted_object"]!).product_name</td>
            <td>@((Product) ViewData["deleted_object"]!).product_description</td>
            <td>@((Product) ViewData["deleted_object"]!).product_existence</td>
            <td>@((Product) ViewData["deleted_object"]!).product_weight</td>
        </tr>
    </table>
}</div>