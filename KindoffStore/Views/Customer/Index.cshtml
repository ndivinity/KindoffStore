@using Databasing;
@using Microsoft.EntityFrameworkCore;
@using Databasing.Entities;

<!-- TODO: Maybe change this to `CustomerIndexModel`. -->
@model CustomerModel

@{
    ViewData["title"] = "Customers";
}

<script>
    const redirectToCreateButton = function() {
        window.location.href = "/Customer/CreateCustomer";
    };
</script>

<div class="app_container text-center" id="app_container" itemid="app_container" name="app_container">@{
    <button onclick="window.location.reload()" class="refresh_list_button">Refresh List</button>
    <button onclick="redirectToCreateButton()" class="create_customer_button">Create Customer</button>
    <br/>

    @if(Model.customer_list != null && Model.customer_list.Any()) {
        @using(Html.BeginForm("DeleteCustomer", "Customer", FormMethod.Post)) {
            <table>
                <tr>
                    <th>Customer Picture</th>
                    <th>Customer ID</th>
                    <th>Customer Name</th>
                    <th>Customer Address</th>
                    <th>Customer Telephone</th>
                    <th hidden="true">Operations</th>
                </tr>

                @foreach(Customer customer in Model.customer_list) {
                    <tr>
                        <td><img class="customer_pic_td" src="@customer.customer_photo_url" alt="Picture of @customer.customer_name" /></td>
                        <td>@customer.customer_id</td>
                        <td>@customer.customer_name</td>
                        <td>@customer.customer_address</td>
                        <td>@customer.customer_telephone</td>
                            <td><button name="customer_id" value="@customer.customer_id" asp-controller="Customer" asp-action="DeleteCustomer">Delete</button></td>
                            <td><button type="button" name="product_id" value="@customer.customer_id" onclick="window.location.href='/Customer/ModifyCustomer?customer_id=@customer.customer_id'">Modify</button></td>
                    </tr>
                }
            </table>
        }

    } else {
        <h2 class="sad_emoticon">:'(</h2>
        <br/>
        <p>The customer list is empty</p>
    }
}</div>